# =
# LOCAL SECRETS - never committed (see .gitignore).
# Copy .env.example to .env and fill in real values.
# =

# ---- POS exe login ----
POS_USER_ID=
POS_PASSWORD=

# ---- Backend web report (demo-backoffice.example.com) ----
WEB_MOBILE=
WEB_PASSWORD=

# ---- SQL Server (READ-ONLY use only) ----
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DRIVER=

# ---- Email after a suite finishes (dashboard "Email devs on finish") ----
# Use an APP password: Office 365 / Gmail refuse the normal account
# password for SMTP. Office 365: smtp.office365.com 587, Gmail: smtp.gmail.com 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_CC=
# Where recipients can open the Allure report; defaults to this machine's LAN IP + :5055
REPORT_BASE_URL=

# individual (default): one mail per person, each sees only their own address | bcc | open
MAIL_PRIVACY=individual

# ---- StoreC (storec-backoffice.example.com) - used by exe_setup when that environment is picked ----
STOREC_MOBILE=
STOREC_PASSWORD=
